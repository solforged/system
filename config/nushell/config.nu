# Starship, Atuin, mise, fnox, zoxide and carapace load after this file, from
# the vendor autoload directory generated by modules/common/shell/nushell.nix.

# --- Options ---
$env.config.show_banner = false
$env.config.edit_mode = "vi"
$env.config.cursor_shape = { vi_insert: line, vi_normal: block }
$env.config.buffer_editor = "nvim"
# Unknown commands highlight as errors before you run them.
$env.config.highlight_resolved_externals = true
$env.config.use_kitty_protocol = true
$env.config.table.mode = "compact"
$env.config.rm.always_trash = true

$env.config.completions.algorithm = "fuzzy"
# Carapace falls back to these shells' completions for commands it lacks.
$env.CARAPACE_BRIDGES = "zsh,fish,bash"

let history_dir = $env.XDG_STATE_HOME? | default ("~/.local/state" | path expand) | path join nushell
mkdir $history_dir
$env.config.history = {
  file_format: sqlite
  path: ($history_dir | path join history.sqlite3)
  max_size: 100_000
  sync_on_enter: true
}

# Atuin binds Ctrl-R and Up itself.
$env.config.keybindings ++= [
  { name: accept_hint, modifier: control, keycode: space, mode: [vi_insert], event: { send: HistoryHintComplete } }
  { name: end_of_line, modifier: control, keycode: char_e, mode: [vi_insert vi_normal], event: { edit: MoveToLineEnd } }
]

# --- Aliases ---
alias grep = grep --color=auto

alias e = nvim
alias gg = lazygit
alias gl = glow -t

alias g = git
alias gcm = git commit -m
alias gcam = git commit -a -m
alias gcad = git commit -a --amend

alias d = docker
alias b = brew
alias bs = brew search
alias decompress = tar -xzf

# nu's own ls returns a table; eza is for the long and tree views.
alias ll = eza --color=auto --group-directories-first --classify=auto -l --time-style=long-iso
alias la = ll -a
alias lt = eza --color=auto --group-directories-first --classify=auto -l --time-style=long-iso --tree --level=2 --icons --git
alias lta = lt -a

alias ff = fzf --preview "bat --style=numbers --color=always --theme=ansi --paging=never -- {}"

# --- Commands ---
def --env cdd [] { cd $env.DOTFILES_DIR }
def --env cdw [] { cd $env.LLM_WIKI_DIR }
def --env eal [] {
  cd $env.DOTFILES_DIR
  run-external ...($env.EDITOR? | default nvim | split row " ") config/nushell/config.nu
}

def --env md [dir: path] { mkdir $dir; cd $dir }

def mup [] { MISE_MINIMUM_RELEASE_AGE=0 mise up }

def cx [] { clear; claude --permission-mode auto }

def compress [dir: path] {
  let dir = $dir | str trim --right --char "/"
  tar -czf $"($dir).tar.gz" $dir
}

# Open nvim on the current directory, or on the given files.
def --wrapped n [...args] {
  if ($args | is-empty) { nvim . } else { nvim ...$args }
}

def --env y [...args] {
  let tmp = mktemp -t "yazi-cwd.XXXXXX"
  yazi ...$args --cwd-file $tmp
  let cwd = open $tmp
  if $cwd != "" and $cwd != $env.PWD and ($cwd | path exists) { cd $cwd }
  rm -fp $tmp
}

# Fuzzy-find a file with a preview and open the pick in $EDITOR.
def eff [...args] {
  let selected = try { ff ...$args | str trim } catch { return }
  if ($selected | is-empty) { return }
  run-external ...($env.EDITOR? | default nvim | split row " ") "--" $selected
}

# omp commit uses its own prompt and will not read AGENTS.md. Inject the
# global commit-msg policy unless the caller already passed --context.
# OMP_LAUNCHER names a wrapper to run instead of omp, such as a sandbox.
def --wrapped omp [...args] {
  let bin = $env.OMP_LAUNCHER? | default omp
  if ($args | first) == "commit" and not ($args | any {|arg| $arg in [--context -c --help -h] }) {
    ^$bin commit --context "Commit messages must pass the global commit-msg policy: Conventional Commits, with a lowercase description after type(scope): and a past-tense subject with no trailing period. Body is optional. If present, use a paragraph or a bullet list (at most three paragraphs)." ...($args | skip 1)
  } else {
    ^$bin ...$args
  }
}
alias omr = omp --resume

# --- Git worktrees ---
# Create a new worktree and branch from within current git directory.
def --env ga [branch: string] {
  let wt_path = $"../($env.PWD | path basename)--($branch)"
  git worktree add -b $branch $wt_path
  if (which mise | is-not-empty) { mise trust $wt_path }
  cd $wt_path
}

# Remove worktree and branch from within active worktree directory.
def --env gd [] {
  try { gum confirm "Remove worktree and branch?" } catch { return }

  let cwd = $env.PWD
  # split on first `--`
  let parts = $cwd | path basename | split row --number 2 "--"

  # Protect against accidentally nuking a non-worktree directory
  if ($parts | length) != 2 {
    error make { msg: "Current directory is not a worktree (does not match <root>--<branch> pattern)" }
  }
  cd $"../($parts.0)"
  git worktree remove $cwd --force
  git branch -D $parts.1
}
