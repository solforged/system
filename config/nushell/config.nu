# Atuin, mise, fnox, zoxide and carapace load after this file, from the vendor
# autoload directory generated by modules/common/shell/nushell.nix. Carapace
# keeps an external completer that is already set.

# --- Options ---
$env.config.show_banner = false
$env.config.edit_mode = "vi"
$env.config.cursor_shape = { vi_insert: line, vi_normal: block }
$env.config.buffer_editor = ($env.EDITOR? | default "ms")
# Unknown commands highlight as errors before you run them.
$env.config.highlight_resolved_externals = true
$env.config.use_kitty_protocol = true
$env.config.table.mode = "compact"
$env.config.rm.always_trash = true
$env.config.error_style = "short"
# A bare directory name enters it, the way zsh autocd does.
$env.config.auto_cd_implicit = true

# Prefix matches, then a pager that stays open while you type. Fuzzy belongs
# to Atuin, not Tab.
$env.config.completions.algorithm = "prefix"
$env.config.completions.persistent_menus = true
# One bridge. Fish and bash bridges only add another shell spawn.
$env.CARAPACE_BRIDGES = "zsh"

let history_dir = $env.XDG_STATE_HOME? | default ("~/.local/state" | path expand) | path join nushell
mkdir $history_dir
$env.config.history = {
  file_format: sqlite
  path: ($history_dir | path join history.sqlite3)
  max_size: 100_000
  sync_on_enter: true
}

# Tab opens the description menu. Ctrl-Space accepts the hint (Right, End, and
# Ctrl-Right already do too). Ctrl-E keeps the default accept-or-end chain.
let edit_modes = [emacs vi_normal vi_insert vi_visual helix_normal helix_select helix_insert]
$env.config.keybindings ++= [
  {
    name: completion_menu
    modifier: none
    keycode: tab
    mode: $edit_modes
    event: {until: [{send: menu, name: ide_completion_menu}, {send: menunext}, {edit: complete}]}
  }
  {
    name: ide_completion_menu
    modifier: control
    keycode: space
    mode: $edit_modes
    event: null
  }
  { name: accept_hint, modifier: control, keycode: space, mode: [vi_insert], event: { send: HistoryHintComplete } }
  { name: prevd, modifier: alt, keycode: left, mode: [vi_insert vi_normal], event: { send: executehostcommand, cmd: "prevd" } }
  { name: nextd, modifier: alt, keycode: right, mode: [vi_insert vi_normal], event: { send: executehostcommand, cmd: "nextd" } }
  { name: insert_last_token, modifier: alt, keycode: char_., mode: [vi_insert vi_normal], event: { send: executehostcommand, cmd: "fish-alt-dot" } }
  { name: prepend_sudo, modifier: alt, keycode: char_s, mode: [vi_insert vi_normal], event: { send: executehostcommand, cmd: "fish-sudo" } }
  { name: insert_file, modifier: control, keycode: char_t, mode: [vi_insert vi_normal], event: { send: executehostcommand, cmd: "fish-insert-file" } }
  { name: dir_history, modifier: alt, keycode: char_c, mode: [vi_insert vi_normal], event: { send: executehostcommand, cmd: "cdh" } }
]

$env.config.menus = $env.config.menus | each {|menu|
  if $menu.name != "ide_completion_menu" {
    $menu
  } else {
    $menu
    | upsert marker ""
    | upsert type ($menu.type | upsert correct_cursor_pos true | upsert description_mode "prefer_right")
  }
}

# Tern reports what it wants through the environment. native-prompt=<style>
# in KITTY_SHELL_INTEGRATION asks for its native prompt; TERN_PROMPT_* give
# that prompt's width, the variables it reports and the file that names the
# current style. They are read once here and kept from every program the
# shell starts, as Tern's fish and zsh integrations do.
let tern = $env.TERM_PROGRAM? == "tern"
let tern_flags = $env.KITTY_SHELL_INTEGRATION? | default "" | split row " "
let tern_style = (
  $tern_flags
  | where {|flag| $flag | str starts-with "native-prompt=" }
  | get 0?
  | default ""
  | str replace "native-prompt=" ""
)
let tern_native = $tern and $tern_style != "" and not ("no-prompt-mark" in $tern_flags)
let tern_columns = $env.TERN_PROMPT_COLUMNS? | default ""
let tern_prompt_file = $env.TERN_PROMPT_FILE? | default ""
let tern_prompt_env = (
  ["PATH" "HOME"]
  | append ($env.TERN_PROMPT_ENV? | default "" | split row ":")
  | where {|name| $name =~ '^[A-Za-z_][A-Za-z0-9_]*$' }
  | uniq
)
let tern_uid = if $tern_native { try { ^id -u | into int } catch { null } } else { null }
hide-env --ignore-errors TERN_PROMPT_COLUMNS TERN_PROMPT_ENV TERN_PROMPT_FILE KITTY_SHELL_INTEGRATION

# --- Prompt ---
# Inside Tern the terminal draws the prompt (see the Tern section). Elsewhere
# (Ghostty, ssh, Tern's `imported` style) this one does: a blank line, host,
# directory and git state, then `>` on the input line, green or red by the
# last status, and `<` in vi normal mode. The input line's right side shows
# the last command's duration from 2 seconds and a failing status.
let prompt_host = try { ^hostname -s | str trim } catch { "" }

# The repository's git directory, found without running git, so a prompt
# outside a repository starts no process.
def prompt-git-dir [] {
  mut dir = $env.PWD
  loop {
    let dot = $dir | path join .git
    let kind = if ($dot | path exists) { $dot | path type } else { "" }
    if $kind == "dir" { return $dot }
    if $kind == "file" {
      # A worktree or submodule: `gitdir: <path>`, maybe relative.
      let target = try { open --raw $dot | str trim | str replace --regex '^gitdir: ' '' } catch { "" }
      return (if $target == "" { null } else { $dir | path join $target })
    }
    let parent = $dir | path dirname
    if $parent == $dir { return null }
    $dir = $parent
  }
}

# A rebase, merge or other operation in progress, with its progress.
def prompt-git-state [gitdir: string] {
  let has = {|name| $gitdir | path join $name | path exists }
  let read = {|name| try { open --raw ($gitdir | path join $name) | str trim } catch { "" } }
  let found = if (do $has rebase-merge) {
    {state: "REBASING", current: (do $read rebase-merge/msgnum), total: (do $read rebase-merge/end)}
  } else if (do $has rebase-apply) {
    let state = if (do $has rebase-apply/rebasing) { "REBASING" } else if (do $has rebase-apply/applying) { "AM" } else { "AM/REBASE" }
    {state: $state, current: (do $read rebase-apply/next), total: (do $read rebase-apply/last)}
  } else if (do $has MERGE_HEAD) {
    {state: "MERGING"}
  } else if (do $has REVERT_HEAD) {
    {state: "REVERTING"}
  } else if (do $has CHERRY_PICK_HEAD) {
    {state: "CHERRY-PICKING"}
  } else if (do $has BISECT_LOG) {
    {state: "BISECTING"}
  } else {
    return ""
  }
  let current = $found.current? | default ""
  let total = $found.total? | default ""
  let progress = if $current != "" and $total != "" { $" ($current)/($total)" } else { "" }
  $" (ansi yellow_bold)|($found.state)($progress)(ansi reset)"
}

# `[branch status]`: the branch, or `@hash` when detached; one symbol per
# kind of change; ahead, behind or diverged from upstream.
def prompt-git [] {
  let gitdir = prompt-git-dir
  if $gitdir == null { return "" }
  let result = do { ^git --no-optional-locks status --porcelain=2 --branch } | complete
  if $result.exit_code != 0 { return "" }
  let lines = $result.stdout | lines
  let branch = (
    $lines
    | where {|line| $line | str starts-with "# branch." }
    | parse "# branch.{key} {value}"
    | reduce --fold {} {|row, acc| $acc | upsert $row.key $row.value }
  )
  let codes = $lines | where {|line| $line =~ '^[12] ' } | each {|line| $line | str substring 2..3 }
  let index = $codes | each {|code| $code | str substring 0..0 }
  let tree = $codes | each {|code| $code | str substring 1..1 }
  let ab = $branch.ab? | default "+0 -0" | split row " " | each {|n| $n | str substring 1.. | into int }
  let ahead = $ab.0? | default 0
  let behind = $ab.1? | default 0
  let symbols = [
    [shown symbol];
    [($lines | any {|line| $line | str starts-with "u " }) $"(ansi red_bold)="]
    [("D" in $index or "D" in $tree) $"(ansi red)✘"]
    [("R" in $index) $"(ansi cyan)»"]
    [("M" in $tree) $"(ansi yellow)!"]
    [("T" in $index or "T" in $tree) $"(ansi yellow)~"]
    [($index | any {|x| $x != "." }) $"(ansi green)+"]
    [($lines | any {|line| $line | str starts-with "? " }) $"(ansi yellow)?"]
    [($ahead > 0 and $behind > 0) $"(ansi yellow)⇕"]
    [($ahead > 0 and $behind == 0) $"(ansi blue)⇡"]
    [($behind > 0 and $ahead == 0) $"(ansi yellow)⇣"]
  ]
  let status = $symbols | where shown | get symbol | str join
  let status = if $status == "" { "" } else { $" ($status)" }
  let head = $branch.head? | default ""
  let name = if $head == "(detached)" {
    $"(ansi yellow)@($branch.oid? | default '' | str substring 0..6)"
  } else {
    $"(ansi blue)($head)"
  }
  $"(ansi blue)[($name)($status)(prompt-git-state $gitdir)(ansi blue)](ansi reset) "
}

# The working directory with `~` for home, cut to its last three parts.
def prompt-dir [] {
  let home = $env.HOME
  let pwd = $env.PWD
  let shown = if $pwd == $home or ($pwd | str starts-with $"($home)/") {
    "~" + ($pwd | str substring ($home | str length)..)
  } else {
    $pwd
  }
  let parts = $shown | split row "/" | where {|part| $part != "" }
  if ($parts | length) > 3 { $"…/($parts | last 3 | str join '/')" } else { $shown }
}

def prompt-duration [ms: int] {
  let s = $ms // 1000
  let h = $s // 3600
  let m = ($s mod 3600) // 60
  let sec = $s mod 60
  if $h > 0 { $"($h)h($m)m($sec)s" } else if $m > 0 { $"($m)m($sec)s" } else { $"($sec)s" }
}

def prompt-char [char: string] {
  let ok = $char == "<" or ($env.LAST_EXIT_CODE? | default 0) == 0
  $"(if $ok { ansi green_bold } else { ansi red_bold })($char)(ansi reset) "
}

$env.PROMPT_COMMAND = {||
  $"\n(ansi dark_gray)($prompt_host)(ansi reset) (ansi blue)(prompt-dir)(ansi reset) (prompt-git)\n"
}
$env.PROMPT_COMMAND_RIGHT = {||
  # CMD_DURATION_MS starts as the placeholder "0823".
  let ms = if $env.CMD_DURATION_MS == "0823" { 0 } else { $env.CMD_DURATION_MS | into int }
  let code = $env.LAST_EXIT_CODE? | default 0
  [
    (if $ms >= 2000 { $"(ansi yellow)(prompt-duration $ms)(ansi reset)" })
    (if $code != 0 { $"(ansi red)($code)(ansi reset)" })
  ] | compact | str join " "
}
$env.config.render_right_prompt_on_last_line = true
$env.PROMPT_INDICATOR = {|| prompt-char ">" }
$env.PROMPT_INDICATOR_VI_INSERT = {|| prompt-char ">" }
$env.PROMPT_INDICATOR_VI_NORMAL = {|| prompt-char "<" }
$env.PROMPT_MULTILINE_INDICATOR = $"(ansi dark_gray)∙(ansi reset) "

# Collapse the two-line prompt in scrollback. Tern's native prompt collapses
# its own bar, so it gets no transient prompt.
if not $tern_native {
  $env.TRANSIENT_PROMPT_COMMAND = ""
  $env.TRANSIENT_PROMPT_INDICATOR = "> "
  $env.TRANSIENT_PROMPT_INDICATOR_VI_INSERT = "> "
  $env.TRANSIENT_PROMPT_INDICATOR_VI_NORMAL = "< "
  $env.TRANSIENT_PROMPT_MULTILINE_INDICATOR = ""
  $env.TRANSIENT_PROMPT_COMMAND_RIGHT = ""
} else {
  hide-env --ignore-errors TRANSIENT_PROMPT_COMMAND TRANSIENT_PROMPT_INDICATOR TRANSIENT_PROMPT_INDICATOR_VI_INSERT TRANSIENT_PROMPT_INDICATOR_VI_NORMAL TRANSIENT_PROMPT_MULTILINE_INDICATOR TRANSIENT_PROMPT_COMMAND_RIGHT
}

# --- Aliases ---
alias grep = grep --color=auto

def --wrapped e [...args] { ^($env.EDITOR? | default "ms") ...$args }
alias gg = lazygit
alias gl = glow -t

# `g` stays an alias. Carapace already completes it as git, and a one-letter
# abbreviation is too easy to expand by accident.
alias g = git

alias d = docker
alias b = brew
alias bs = brew search
alias decompress = tar -xzf

# Abbreviations expand on Space, so history stores the long command. Enter
# only expands the word at the cursor, so a pasted `ll --version` would miss.
# The aliases cover that path.
let eza_long = "eza --color=auto --group-directories-first --classify=auto -l --time-style=long-iso"
alias ll = eza --color=auto --group-directories-first --classify=auto -l --time-style=long-iso
alias la = ll -a
alias lt = eza --color=auto --group-directories-first --classify=auto -l --time-style=long-iso --tree --level=2 --icons --git
alias lta = lt -a
alias gcm = git commit -m
alias gcam = git commit -a -m
alias gcad = git commit -a --amend
$env.config.abbreviations = {
  ll: $eza_long
  la: $"($eza_long) -a"
  lt: $"($eza_long) --tree --level=2 --icons --git"
  lta: $"($eza_long) --tree --level=2 --icons --git -a"
  gcm: "git commit -m"
  gcam: "git commit -a -m"
  gcad: "git commit -a --amend"
}

# --- Commands ---
def --env cdd [] { cd $env.DOTFILES_DIR }
def --env cdw [] { cd $env.LLM_WIKI_DIR }
def --env eal [] {
  cd $env.DOTFILES_DIR
  run-external ...($env.EDITOR? | default nvim | split row " ") config/nushell/config.nu
}

def --env md [dir: path] { mkdir $dir; cd $dir }

def --env .. [] { cd .. }
def --env ... [] { cd ../.. }

def mup [] { MISE_MINIMUM_RELEASE_AGE=0 mise up }

def cx [] { clear; claude --permission-mode auto }

def compress [dir: path] {
  let dir = $dir | str trim --right --char "/"
  tar -czf $"($dir).tar.gz" $dir
}

# Open nvim on the current directory, or on the given files.
def --wrapped n [...args] {
  if ($args | is-empty) { nvim . } else { nvim ...$args }
}

def --env y [...args] {
  let tmp = mktemp -t "yazi-cwd.XXXXXX"
  yazi ...$args --cwd-file $tmp
  let cwd = open $tmp
  if $cwd != "" and $cwd != $env.PWD and ($cwd | path exists) { cd $cwd }
  rm -fp $tmp
}

# Fuzzy-find a file with a preview and open the pick in $EDITOR.
def eff [...args] {
  let selected = try { ff ...$args | str trim } catch { return }
  if ($selected | is-empty) { return }
  run-external ...($env.EDITOR? | default nvim | split row " ") "--" $selected
}

# omp commit uses its own prompt and will not read AGENTS.md. Inject the
# global commit-msg policy unless the caller already passed --context.
# OMP_LAUNCHER names a wrapper to run instead of omp, such as a sandbox.
def --wrapped omp [...args] {
  let bin = $env.OMP_LAUNCHER? | default omp
  if ($args | first) == "commit" and not ($args | any {|arg| $arg in [--context -c --help -h] }) {
    ^$bin commit --context "Commit messages must pass the global commit-msg policy: Conventional Commits, with a lowercase description after type(scope): and a past-tense subject with no trailing period. Body is optional. If present, use a paragraph or a bullet list (at most three paragraphs)." ...($args | skip 1)
  } else {
    ^$bin ...$args
  }
}
alias omr = omp --resume
alias pir = pi --resume

# --- Git worktrees ---
# Create a new worktree and branch from within current git directory.
def --env ga [branch: string] {
  let wt_path = $"../($env.PWD | path basename)--($branch)"
  git worktree add -b $branch $wt_path
  if (which mise | is-not-empty) { mise trust $wt_path }
  cd $wt_path
}

# Remove worktree and branch from within active worktree directory.
def --env gd [] {
  try { gum confirm "Remove worktree and branch?" } catch { return }

  let cwd = $env.PWD
  # split on first `--`
  let parts = $cwd | path basename | split row --number 2 "--"

  # Protect against accidentally nuking a non-worktree directory
  if ($parts | length) != 2 {
    error make { msg: "Current directory is not a worktree (does not match <root>--<branch> pattern)" }
  }
  cd $"../($parts.0)"
  git worktree remove $cwd --force
  git branch -D $parts.1
}

# --- Fish-like editing ---
$env.FISH_DIR_BACK = []
$env.FISH_DIR_FWD = []
$env.FISH_DIR_SKIP = false

def --env prevd [] {
  let back = $env.FISH_DIR_BACK? | default []
  if ($back | is-empty) { return }
  let dest = $back | last
  let here = $env.PWD
  if $dest == $here {
    $env.FISH_DIR_BACK = $back | drop 1
    return
  }
  $env.FISH_DIR_SKIP = true
  let moved = try { cd $dest; true } catch { false }
  if not $moved {
    $env.FISH_DIR_SKIP = false
    return
  }
  $env.FISH_DIR_BACK = $back | drop 1
  $env.FISH_DIR_FWD = ($env.FISH_DIR_FWD? | default []) | append $here | last 100
  $env.FISH_DIR_SKIP = false
}

def --env nextd [] {
  let fwd = $env.FISH_DIR_FWD? | default []
  if ($fwd | is-empty) { return }
  let dest = $fwd | last
  let here = $env.PWD
  if $dest == $here {
    $env.FISH_DIR_FWD = $fwd | drop 1
    return
  }
  $env.FISH_DIR_SKIP = true
  let moved = try { cd $dest; true } catch { false }
  if not $moved {
    $env.FISH_DIR_SKIP = false
    return
  }
  $env.FISH_DIR_FWD = $fwd | drop 1
  $env.FISH_DIR_BACK = ($env.FISH_DIR_BACK? | default []) | append $here | last 100
  $env.FISH_DIR_SKIP = false
}

def fish-history-line [index: int] {
  let path = $env.config.history.path?
  if $path == null or not ($path | path exists) { return null }
  let row = try {
    open $path | query db "SELECT command_line FROM history ORDER BY id DESC LIMIT 1 OFFSET ?" -p [$index]
  } catch { return null }
  if ($row | is-empty) { return null }
  $row | get command_line.0
}

def fish-last-token [line: string] {
  let line = $line | str trim
  if ($line | is-empty) { return null }
  let parts = $line | split row " " | where {|part| not ($part | is-empty)}
  if ($parts | is-empty) { return null }
  $parts | last
}

def --env fish-alt-dot [] {
  let line = commandline
  let cursor = commandline get-cursor
  let prev = $env.FISH_ALT_DOT_TEXT? | default ""
  let prev_index = $env.FISH_ALT_DOT_INDEX? | default (-1)
  let prev_len = $prev | str length
  let continuing = (
    $prev_index >= 0
    and $prev_len > 0
    and $cursor >= $prev_len
    and (($line | str substring ($cursor - $prev_len)..<$cursor) == $prev)
  )
  let index = if $continuing { $prev_index + 1 } else { 0 }
  let hist = fish-history-line $index
  if $hist == null { return }
  let token = fish-last-token $hist
  if $token == null { return }
  let quoted = if ($token | str contains " ") or ($token | str contains "'") {
    $token | to nuon
  } else {
    $token
  }
  if $continuing {
    let start = $cursor - $prev_len
    let next = ($line | str substring 0..<$start) + $quoted + ($line | str substring $cursor..)
    commandline edit --replace $next
    commandline set-cursor ($start + ($quoted | str length))
  } else {
    commandline edit --insert $quoted
  }
  $env.FISH_ALT_DOT_TEXT = $quoted
  $env.FISH_ALT_DOT_INDEX = $index
}

def fish-sudo [] {
  let line = commandline
  if ($line | str starts-with "sudo ") { return }
  let next = if ($line | str trim | is-empty) {
    let prev = fish-history-line 0
    if $prev == null { "" } else { $"sudo ($prev)" }
  } else {
    $"sudo ($line)"
  }
  if ($next | is-empty) { return }
  commandline edit --replace $next
  commandline set-cursor ($next | str length)
}

def fish-pick [feed: list<string>, prompt: string] {
  let result = try {
    $feed | str join (char nl) | ^fzf --height=40% --reverse --prompt=$prompt | complete
  } catch { return null }
  if $result.exit_code != 0 { return null }
  let pick = $result.stdout | str trim
  if ($pick | is-empty) { null } else { $pick }
}

def fish-insert-file [] {
  let feed = if (which fd | is-not-empty) {
    ^fd --hidden --exclude .git --exclude target --exclude node_modules | complete
  } else if (which rg | is-not-empty) {
    ^rg --files --hidden --glob '!.git/**' --glob '!target/**' --glob '!node_modules/**' | complete
  } else {
    ^ls | complete
  }
  if $feed.exit_code != 0 { return }
  let pick = fish-pick ($feed.stdout | lines) "file> "
  if $pick == null { return }
  let inserted = if ($pick | str contains " ") or ($pick | str contains "'") {
    $pick | to nuon
  } else {
    $pick
  }
  commandline edit --insert $inserted
}

def --env cdh [] {
  let listed = try { ^zoxide query -l | complete } catch { return }
  if $listed.exit_code != 0 { return }
  let pick = fish-pick ($listed.stdout | lines) "cd> "
  if $pick == null { return }
  cd $pick
}

def fish-like-escape [text: string] {
  $text | str replace --all '\' '\\' | str replace --all '%' '\%' | str replace --all '_' '\_'
}

def fish-hint [ctx: record] {
  let line = $ctx.line
  if ($line | is-empty) or $ctx.pos != ($line | str length) { return null }
  let path = $env.config.history.path?
  if $path == null or not ($path | path exists) { return null }
  let row = try {
    open $path | query db "SELECT command_line FROM history WHERE command_line LIKE ? ESCAPE '\\' AND command_line != ? AND command_line NOT IN ('ls', 'cd', 'clear', 'exit') ORDER BY (cwd = ?) DESC, id DESC LIMIT 1" -p [($"((fish-like-escape $line))%") $line ($ctx.cwd? | default "")]
  } catch { return null }
  if ($row | is-empty) { return null }
  let match = $row | get command_line.0
  if ($match | str length) <= ($line | str length) { return null }
  $match | str substring ($line | str length)..
}

$env.config.hinter.closure = {|ctx| fish-hint $ctx }

def fish-packages [name: string] {
  if (which nix-locate | is-empty) { return "" }
  let found = try { ^nix-locate --top-level --whole-name --at-root $"bin/($name)" | complete } catch { return "" }
  if $found.exit_code != 0 { return "" }
  let lines = $found.stdout | lines | where {|line| not ($line | is-empty)} | first 5
  if ($lines | is-empty) { return "" }
  $"may be provided by: ($lines | str join ', ')"
}

def fish-missing [name: string] {
  let near = (
    help commands
    | get name
    | each {|command| $command | split row " " | first}
    | uniq
    | each {|command| {name: $command, distance: ($command | str distance $name)}}
    | where {|row| $row.distance > 0 and $row.distance <= 2}
    | sort-by distance
    | first 3
  )
  let hint = if ($near | is-empty) { "" } else { $"Did you mean ($near.name | str join ', ')?" }
  let pkgs = fish-packages $name
  [$"Command ($name) not found" $hint $pkgs] | where {|part| not ($part | is-empty)} | str join "\n"
}

# --- Tern ---
# Tern ships shell integration for fish, zsh, bash, xonsh and PowerShell, not
# for Nushell. Nushell's own OSC 133 marks give Tern the prompt rows and each
# command's status. These hooks add the rest of what those integrations
# report. Before a command: the command line, which a command lens needs to
# recognize `git log` or `gh pr list`, and the pager variables that let the
# lens read the output instead of a pager. Before a prompt: the native
# prompt's state, and the prompt itself as blank columns Tern draws over.

# A command line as one shell word, for cmdline= in OSC 133;C.
def tern-quote [text: string] {
  $"'($text | str replace --all "'" "'\\''")'"
}

# The pager and progress variables that keep a command line from paging or
# redrawing, so Tern can show its output natively. Lines with pipes, lists or
# redirections get none. Ported from Tern's fish and xonsh integrations.
def tern-hints [line: string] {
  if $env.TERN_LENSES? != "1" or $line =~ '[|;&<>]' { return {} }
  mut words = $line | split row --regex '\s+' | where {|word| $word != "" }
  while ($words | is-not-empty) {
    if $words.0 in [sudo env time command nice nohup] {
      $words = $words | skip 1
      while ($words | is-not-empty) and ($words.0 | str starts-with "-") { $words = $words | skip 1 }
    } else if $words.0 =~ '^[A-Za-z_][A-Za-z0-9_]*=' {
      $words = $words | skip 1
    } else {
      break
    }
  }
  if ($words | is-empty) { return {} }
  let prog = $words.0 | str trim --left --char "^" | path basename
  mut rest = $words | skip 1
  if $prog == "git" {
    while ($rest | is-not-empty) and ($rest.0 | str starts-with "-") {
      # `git -p log` asks for the pager: leave it be.
      if $rest.0 in [-p --paginate] { return {} }
      $rest = $rest | skip (if $rest.0 in [-C -c] { 2 } else { 1 })
    }
    let sub = $rest.0? | default ""
    if $sub == "diff" {
      # An external diff tool (difftastic) prints what no lens reads, so
      # git's pager stays.
      if not ("--no-ext-diff" in $rest) {
        if ($env.GIT_EXTERNAL_DIFF? | default "") != "" { return {} }
        let external = try { ^git config --get diff.external | str trim } catch { "" }
        if $external != "" { return {} }
      }
      return {GIT_PAGER: "cat"}
    }
    let paged = [log show branch tag stash reflog blame shortlog grep ls-files ls-tree]
    return (if $sub in $paged { {GIT_PAGER: "cat"} } else { {} })
  }
  if $prog == "docker" {
    let building = ($rest.0? == "build") or ($rest.0? in [compose buildx] and $rest.1? == "build")
    return (if $building { {BUILDKIT_PROGRESS: "plain"} } else { {} })
  }
  {
    gh: {GH_PAGER: "cat"}
    man: {MANPAGER: "cat"}
    systemctl: {SYSTEMD_PAGER: "cat"}
    journalctl: {SYSTEMD_PAGER: "cat"}
    aws: {AWS_PAGER: ""}
    bat: {BAT_PAGING: "never"}
    psql: {PSQL_PAGER: "cat"}
    ls: {CLICOLOR: "1"}
  } | get --optional $prog | default {}
}

# Marks the start of a command's output with its command line, and exports the
# pager hints for it. An alias is reported with its expansion, which is what a
# lens recognizes.
def --env tern-preexec [] {
  $env.TERN_RAN = true
  if "no-prompt-mark" in $tern_flags { return }
  let line = commandline
  let trimmed = $line | str trim --left
  let first = $trimmed | split row --regex '\s' | get 0? | default ""
  let expansion = if $first == "" { null } else { scope aliases | where name == $first | get 0?.expansion? }
  let expanded = if $expansion == null { $line } else { $trimmed | str replace $first $expansion }
  let printable = not ($line =~ '[\x00-\x1f\x7f]') and not ($expanded =~ '[\x00-\x1f\x7f]')
  if $expanded != $line and $printable {
    print -n $"\e]133;C;cmdline=(tern-quote $line);cmdline_expanded=(tern-quote $expanded)\a"
  } else {
    print -n $"\e]133;C;cmdline_url=($line | url encode --all)\a"
  }
  let hints = tern-hints $expanded
  if ($hints | is-empty) { return }
  $env.TERN_HINTED = $hints | columns | each {|name| {name: $name, old: ($env | get --optional $name)} }
  load-env $hints
}

# Puts back what the pager hints replaced.
def --env tern-unhint [] {
  let hinted = $env.TERN_HINTED? | default []
  if ($hinted | is-empty) { return }
  let restore = $hinted | where old != null | reduce --fold {} {|hint, acc| $acc | insert $hint.name $hint.old }
  hide-env --ignore-errors ...$hinted.name TERN_HINTED
  load-env $restore
}

# The native prompt's width: the control file's line when it holds a style and
# a width, else the spawn's. Null for `imported` or no width, which leave the
# user's own prompt in place.
def tern-prompt-columns [] {
  mut style = $tern_style
  mut columns = $tern_columns
  if $tern_prompt_file != "" and ($tern_prompt_file | path exists) {
    let fields = try { open --raw $tern_prompt_file | lines | get 0? | default "" | split row "\t" } catch { [] }
    if ($fields.0? | default "") != "" and ($fields.1? | default "") != "" {
      $style = $fields.0
      $columns = $fields.1
    }
  }
  if $style == "imported" or not ($columns =~ '^[0-9]+$') { null } else { $columns | into int }
}

# The shell state Tern's prompt shows, as JSON: the last status, the duration
# when a command ran since the last prompt, background jobs, the effective uid
# and the TERN_PROMPT_ENV variables that are set. Nushell does not expose the
# line editor's vi mode, so the state always says insert, which is the mode
# every new prompt starts in. Esc does not change Tern's prompt character.
def tern-state [ran: bool] {
  let reported = $tern_prompt_env | reduce --fold {} {|name, acc|
    let value = $env | get --optional $name
    let kind = $value | describe
    let text = if $kind == "string" {
      $value
    } else if ($kind | str starts-with "list") {
      try { $value | each {|item| $item | into string } | str join (if ($name | str ends-with "PATH") { ":" } else { " " }) } catch { null }
    } else {
      null
    }
    if $text == null { $acc } else { $acc | insert $name $text }
  }
  mut state = {status: ($env.LAST_EXIT_CODE? | default 0)}
  if $ran {
    let ms = try { $env.CMD_DURATION_MS | into int } catch { null }
    if $ms != null { $state = $state | insert duration_ms $ms }
  }
  $state = $state | insert jobs (job list | length) | insert vi "insert"
  if $tern_uid != null { $state = $state | insert uid $tern_uid }
  $state | insert env $reported | to json --raw
}

# Sends the state of the prompt about to be drawn, then hands the prompt to
# Tern for a preset style: that many blank columns, no indicator and no right
# prompt. The prompt from the Prompt section stays for `imported` and outside
# Tern. This runs before every prompt because the control file can change the
# style between prompts.
def --env tern-prompt [] {
  tern-unhint
  let ran = $env.TERN_RAN? == true
  hide-env --ignore-errors TERN_RAN
  if not $tern_native { return }
  print -n $"\e_npp;s;(tern-state $ran)\e\\"
  let names = [PROMPT_COMMAND PROMPT_COMMAND_RIGHT PROMPT_INDICATOR PROMPT_INDICATOR_VI_INSERT PROMPT_INDICATOR_VI_NORMAL]
  let columns = tern-prompt-columns
  if $columns != null {
    if $env.TERN_USER_PROMPT? == null {
      let present = $env | columns
      $env.TERN_USER_PROMPT = $names | where {|name| $name in $present } | each {|name| {($name): ($env | get $name)} } | into record
    }
    $env.PROMPT_COMMAND = "" | fill --character " " --width $columns
    $env.PROMPT_COMMAND_RIGHT = ""
    $env.PROMPT_INDICATOR = ""
    $env.PROMPT_INDICATOR_VI_INSERT = ""
    $env.PROMPT_INDICATOR_VI_NORMAL = ""
  } else if $env.TERN_USER_PROMPT? != null {
    let user = $env.TERN_USER_PROMPT
    hide-env --ignore-errors ...$names TERN_USER_PROMPT
    load-env $user
  }
}

$env.config.hooks.env_change.PWD = (
  $env.config.hooks.env_change.PWD? | default [] | append {|before, after|
    if $before == null or $before == $after { return }
    if $env.FISH_DIR_SKIP? == true {
      $env.FISH_DIR_SKIP = false
      return
    }
    $env.FISH_DIR_BACK = ($env.FISH_DIR_BACK? | default []) | append $before | last 100
    $env.FISH_DIR_FWD = []
  }
)
$env.config.hooks.command_not_found = {|name| fish-missing $name }
if $tern {
  $env.config.hooks.pre_execution = $env.config.hooks.pre_execution | append {|| tern-preexec }
  $env.config.hooks.pre_prompt = $env.config.hooks.pre_prompt | append {|| tern-prompt }
}

# --- External completions ---
# Carapace's own specs cover git, jj, mise, nix, cargo, gh, ssh, and docker.
# A second completer for those would be a worse copy. CARAPACE_BRIDGES=zsh
# sends every other command through a zsh spawn, so those get a short budget
# and fall back to files. Commands with a native spec get a longer one, and a
# timeout there shows nothing rather than a file list that looks like an
# answer.
const fish_native_specs = [git jj mise nix cargo gh ssh docker kubectl npm bun rg]

def fish-spans [place] {
  if ($place | describe | str starts-with "record") {
    $place.command? | default []
  } else {
    $place
  }
}

def --env fish-carapace-env [] {
  if $env.FISH_CARAPACE_ENV? != null { return }
  $env.FISH_CARAPACE_ENV = {
    CARAPACE_SHELL: "nushell"
    CARAPACE_SHELL_ALIASES: (scope aliases | get name | uniq | str join "\n")
    CARAPACE_SHELL_BUILTINS: (help commands | where category != "" | get name | each {|command| $command | split row " " | first} | uniq | str join "\n")
    CARAPACE_SHELL_FUNCTIONS: (help commands | where category == "" | get name | each {|command| $command | split row " " | first} | uniq | str join "\n")
    CARAPACE_SHELL_VARIABLES: (scope variables | get name | uniq | str join "\n")
  }
}

# The command the first span runs, with an alias expanded.
def fish-head [spans: list<string>] {
  let expanded = scope aliases | where name == $spans.0 | get 0?.expansion?
  if $expanded != null { $expanded | split row " " | first } else { $spans.0 }
}

def fish-carapace [place, carapace_env: record] {
  let spans = fish-spans $place
  if ($spans | is-empty) { return null }
  let spans = $spans | skip 1 | prepend (fish-head $spans)
  if ($spans | length) <= 1 { return null }
  with-env $carapace_env {
    carapace $spans.0 nushell ...$spans | from json
  }
}

# Files for the token at the cursor, the way fish lists them: relative paths
# stay relative, `~` stays `~`, dotfiles only when the name starts with a dot,
# and a token holding *, ? or [ lists what it matches. In VAR=value and
# --flag=value the value completes.
def fish-file-completions [token: string] {
  let eq = $token | str index-of "="
  if $eq > 0 {
    let prefix = $token | str substring ..$eq
    return (fish-file-completions ($token | str substring ($eq + 1)..) | each {|row| {value: $"($prefix)($row.value)"} })
  }
  let token = $token | str trim --char "'" | str trim --char '"' | str trim --char '`'
  let home = $env.HOME
  let tilde = $token == "~" or ($token | str starts-with "~/")
  let expanded = if $tilde { $home + ($token | str substring 1..) } else { $token }
  let pattern = if $expanded =~ '[*?\[]' { $expanded } else { $"($expanded)*" }
  let hidden = $expanded | split row "/" | last | str starts-with "."
  try {
    ls --all ($pattern | into glob)
    | where {|row| $hidden or not ($row.name | path basename | str starts-with ".") }
    | first 40
    | each {|row|
      let name = if $tilde { $row.name | str replace $home "~" } else { $row.name }
      let is_dir = $row.type == "dir" or ($row.type == "symlink" and (try { ($row.name | path expand | path type) == "dir" } catch { false }))
      if $is_dir { {value: $"($name)/"} } else { {value: $name} }
    }
  } catch { [] }
}

def fish-complete [place] {
  let spans = fish-spans $place
  if ($spans | length) <= 1 { return null }
  let token = $spans | last
  # Carapace does not expand globs.
  if $token =~ '[*?\[]' { return (fish-file-completions $token) }
  let native = (fish-head $spans | path basename) in $fish_native_specs
  fish-carapace-env
  let carapace_env = $env.FISH_CARAPACE_ENV
  let tag = random int 1..1_000_000_000
  let id = job spawn {
    let result = try { fish-carapace $place $carapace_env } catch { null }
    {value: $result} | job send 0 --tag $tag
  }
  let got = try { job recv --tag $tag --timeout (if $native { 350ms } else { 80ms }) } catch { {timeout: true} }
  if $got.timeout? == true {
    try { job kill $id } catch {}
    try { job flush } catch {}
    return (if $native { [] } else { fish-file-completions $token })
  }
  $got.value
}

$env.config.completions.external.completer = {|place| fish-complete $place }
