{
  "theme": {
    "mode": "system",
    "dark": "Solforge Dark",
    "light": "Solforge Light"
  },
  "edit_predictions": {
    "mode": "subtle"
  },
  "languages": {
    "Markdown": {
      "formatter": {
        "external": {
          "command": "dprint",
          "arguments": [
            "fmt",
            "--stdin",
            "{buffer_path}",
            "--config-discovery=global"
          ]
        }
      },
      "format_on_save": "on",
      "preferred_line_length": 80
    }
  },
  "ui_font_size": 16.0,
  "buffer_font_size": 13.0,
  "cli_default_open_behavior": "new_window",
  "git_panel": {
    "file_icons": true
  },
  "terminal": {
    "show_count_badge": false,
    "shell": {
      "program": "nu"
    }
  },
  "project_panel": {
    "git_status_indicator": true,
    "bold_folder_labels": false
  },
  "buffer_font_family": "Berkeley Mono Variable",
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "vim_mode": true
}
