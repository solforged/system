# Keep terminal behavior quiet and portable across hosts.
theme = dark:solforge-dark,light:solforge-light
font-size = 12
font-family = Berkeley Mono Variable
shell-integration = zsh
# Written by modules/common/shell/nushell.nix to open nu instead. Ghostty
# loads includes after this whole file, so it overrides the line above.
config-file = ?shell.ghostty
# Protect text from hard-coded application colors. 4:1 matches Solforge's
# ANSI floor, so dim text on a lightly raised surface keeps its colour.
minimum-contrast = 4
window-padding-x = 6
window-padding-y = 4
window-padding-balance = true

# Match common macOS terminal ergonomics.
macos-option-as-alt = true

# Keep new tabs/windows in the current project when possible.
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true

# Make selection-copy explicit.
copy-on-select = clipboard

# Preserve modified Enter for terminal apps and make split resizing explicit.
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
keybind = shift+enter=csi:13;2u
keybind = alt+shift+enter=csi:13;4u
keybind = super+control+shift+alt+arrow_down=resize_split:down,100
keybind = super+control+shift+alt+arrow_up=resize_split:up,100
keybind = super+control+shift+alt+arrow_left=resize_split:left,100
keybind = super+control+shift+alt+arrow_right=resize_split:right,100
