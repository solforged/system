# modules/common/shell/zsh.nix
#
# ZDOTDIR is ~/.config/zsh, linked to config/zsh. Plugins and tool init code
# are generated in the store and sourced by .zshrc.
{
  config,
  lib,
  pkgs,
  ...
}:

let
  cfg = config.modules.shell.zsh;
  plugins = ''
    # Generated by modules/common/shell/zsh.nix.
    fpath=(${pkgs.zsh-completions}/share/zsh/site-functions $fpath)
    mkdir -p "''${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
    autoload -Uz compinit
    compinit -d "''${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump"

    source ${pkgs.zsh-fzf-tab}/share/fzf-tab/fzf-tab.plugin.zsh
    source ${pkgs.zsh-abbr}/share/zsh/zsh-abbr/zsh-abbr.plugin.zsh
    source ${pkgs.zsh-autosuggestions}/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
    source ${pkgs.zsh-syntax-highlighting}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
    source ${pkgs.zsh-history-substring-search}/share/zsh/plugins/zsh-history-substring-search/zsh-history-substring-search.zsh
  '';
  pluginsFile = pkgs.runCommand "zsh-plugins.zsh" { } ''
    export HOME="$TMPDIR/home"
    mkdir -p "$HOME"
    cat ${pkgs.writeText "zsh-plugins-base.zsh" plugins} > "$out"
    ${lib.optionalString config.modules.shell.atuin.enable ''
      ${pkgs.atuin}/bin/atuin init zsh --disable-ai >> "$out"
    ''}
  '';
  initFile = pkgs.runCommand "zsh-init.zsh" { } ''
    export HOME="$TMPDIR/home"
    mkdir -p "$HOME"
    touch "$out"
    ${lib.optionalString config.modules.shell.starship.enable ''
      echo 'if [[ "''${TERM:-}" != dumb ]]; then' >> "$out"
      ${pkgs.starship}/bin/starship init zsh --print-full-init >> "$out"
      echo 'fi' >> "$out"
    ''}
    ${lib.optionalString config.modules.shell.mise.enable ''
      ${pkgs.mise}/bin/mise activate zsh > "$TMPDIR/mise.zsh"
      # Keep the caller's PATH. The initial exports capture the build environment.
      ${pkgs.gnused}/bin/sed '/^export __MISE_ORIG_PATH=/d; /^export PATH=/d' "$TMPDIR/mise.zsh" >> "$out"
    ''}
    ${lib.optionalString config.modules.shell.fnox.enable ''
      ${pkgs.fnox}/bin/fnox activate zsh >> "$out"
    ''}
    ${pkgs.zoxide}/bin/zoxide init zsh >> "$out"
  '';
in
{
  options.modules.shell.zsh.enable = lib.mkEnableOption "zsh";

  config = lib.mkIf cfg.enable {
    programs.zsh = {
      enable = true;
      # plugins.zsh runs compinit, and Starship draws the prompt.
      enableGlobalCompInit = false;
      promptInit = "";
    };

    modules.env.variables = {
      ZDOTDIR = "$HOME/.config/zsh";
      PAGER = "moor";
      MOOR = "--no-linenumbers";
    };

    modules.dotfiles.configLink.zsh = "zsh";

    hm = {
      home.packages =
        (with pkgs; [
          fzf
          gum
          jq
          moor
          rsync
          zoxide
        ])
        ++ lib.optionals pkgs.stdenv.hostPlatform.isLinux [ pkgs.inotify-tools ];
      home.file.".hushlogin".text = "";
      xdg.dataFile = {
        "zsh/plugins.zsh".source = pluginsFile;
        "zsh/init.zsh".source = initFile;
      };
    };
  };
}
